# Copy this file to .env for local testing, or paste these into
# Render's Environment tab (one key/value per row) for deployment.
# Never commit a real .env file — it's already in .gitignore.

# --- Required ---

# Token from @BotFather on Telegram
BOT_TOKEN=123456789:AAExampleTokenReplaceWithYourOwn

# Your numeric Telegram user id (get it from @userinfobot)
ADMIN_ID=123456789

# --- Required for deployment (webhook mode), omit for local polling ---

# Your Render service URL, no trailing slash
WEBHOOK_URL=https://your-app-name.onrender.com

# Optional: override the webhook path (defaults to BOT_TOKEN if unset)
WEBHOOK_SECRET_PATH=

# --- Optional: pin the Python version Render builds with ---
PYTHON_VERSION=3.12.7

# --- Optional: AI auto-chat (/ai on) ---
# Pick ONE provider below and fill in its section. AI_PROVIDER controls
# which one the bot actually uses.

AI_PROVIDER=anthropic
# AI_PROVIDER=openai_compatible

# System prompt used by either provider (optional, has a sensible default)
AI_SYSTEM_PROMPT=You are a helpful assistant answering Telegram messages on behalf of the bot's owner while they're away. Be warm, concise, and clear that you're an AI stand-in if it comes up.

# --- Option A: Anthropic (no permanent free tier - needs billing set up
#     after any trial credit runs out) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5

# --- Option B: any OpenAI-compatible provider (use with
#     AI_PROVIDER=openai_compatible). A few free-tier examples,
#     uncomment ONE model/base_url pair and set AI_API_KEY to that
#     provider's key:

# Groq (fast, no credit card - console.groq.com). Their lineup changes
# often — check https://console.groq.com/docs/models for current model
# IDs, or hit https://api.groq.com/openai/v1/models with your key to see
# exactly what your account can use, before picking one.
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b

# Google Gemini (free tier via Google AI Studio - aistudio.google.com)
# AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-2.5-flash

# OpenRouter (aggregates many free models - openrouter.ai)
# AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=<pick a model ending in ":free" from openrouter.ai/models>

# --- Optional: web server port (Render sets this automatically) ---

PORT=8080
