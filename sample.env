# Copy this file to .env for local testing, or paste these into
# Render's Environment tab (one key/value per row) for deployment.
# Never commit a real .env file — it's already in .gitignore.

# --- Required ---

# Token from @BotFather on Telegram
BOT_TOKEN=123456789:AAExampleTokenReplaceWithYourOwn

# Your numeric Telegram user id (get it from @userinfobot)
ADMIN_ID=123456789

# --- Required for deployment (webhook mode), omit for local polling ---

# Your Render service URL, no trailing slash
WEBHOOK_URL=https://your-app-name.onrender.com

# Optional: override the webhook path (defaults to BOT_TOKEN if unset)
WEBHOOK_SECRET_PATH=

# --- Optional: AI auto-chat (/ai on) ---

# From console.anthropic.com - leave blank to keep AI mode unavailable
ANTHROPIC_API_KEY=

# Defaults to claude-sonnet-4-5 if unset
AI_MODEL=claude-sonnet-4-5

# Defaults to a generic "helpful stand-in" prompt if unset
AI_SYSTEM_PROMPT=You are a helpful assistant answering Telegram messages on behalf of the bot's owner while they're away. Be warm, concise, and clear that you're an AI stand-in if it comes up.

# --- Optional: web server port (Render sets this automatically) ---

PORT=8080
